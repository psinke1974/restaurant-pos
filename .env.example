# Copy to `.env` (gitignored) and fill in the secrets. Vite reads the VITE_*
# values; docker compose reads SURREAL_* for the database and server services.

# --- Database (server side only, never exposed to the browser) ---
SURREAL_USER=root
# Required: pick a long random password, e.g. `openssl rand -base64 24`.
SURREAL_PASS=

# --- Frontend ---
VITE_BASE_URL=localhost
VITE_DECIMAL_PLACES=2
VITE_LOCALE=es-ES
VITE_DEFAULT_LANGUAGE=es
VITE_APP_TIMEZONE=Europe/Madrid
VITE_CURRENCY=EUR
VITE_DB_WEBDOCKET=ws://localhost:8000
VITE_DATE_FORMAT=yyyy-MM-dd
VITE_TIME_FORMAT="HH:mm"
VITE_DATE_TIME_FORMAT="${VITE_DATE_FORMAT} ${VITE_TIME_FORMAT}"
VITE_DATE_HUMAN_FORMAT="ff"
VITE_DB_DATABASE_DATE_FORMAT="%Y-%m-%d"
VITE_DB_DATABASE_FORMAT="${VITE_DB_DATABASE_DATE_FORMAT} %H:%M"
VITE_PRINT_SERVER_URL=http://localhost:3132
VITE_PAYMENT_SERVER_URL=http://localhost:3134
# Public URL of YOUR payment server for gateway callbacks. Empty = VITE_PAYMENT_SERVER_URL.
VITE_PAYMENT_CALLBACK_SERVER_URL=
VITE_TRACKING_SERVER_URL=http://localhost:3138
VITE_API_SERVER_URL=http://localhost:3140
VITE_GOOGLE_MAPS_API_KEY=
# AI credentials live server-side in api/.env.local (OPENAI_*). Do not add the key here.
# Set to "true" only when the api service uses a small/local model that needs a compact prompt.
VITE_AI_REPORT_COMPACT=false
# Google Analytics 4 measurement id. Leave empty to disable tracking (requires cookie consent under GDPR).
VITE_GA4_ID=
VITE_RESTAURANT_NAME=
VITE_RESTAURANT_ADDRESS=
